# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored — never commit it.
# Generate passwords/keys on the server, e.g.:  openssl rand -hex 24

# --- stack ---
# web = HTTPS proxy + Mini App, telegram = bot + userbot worker.
# Only ONE bot process may poll a token: stop the PC "coming soon" stub before enabling `telegram` here.
COMPOSE_PROFILES=web,telegram
POSTGRES_PASSWORD=change-me
TULPORGO_DOMAIN=tulporgo.uz
TULPORGO_IMAGE_TAG=local
# decision 58: one automatic dump a month (day 1..28), only the newest kept; manual: docker compose run --rm backup --once
BACKUP_KEEP_COUNT=1
BACKUP_DAY_OF_MONTH=1
BACKUP_AT_UTC=22:00
# off-site copy to Cloudflare R2, encrypted on this server first (empty = off). Key: keep a copy offline!
#   docker compose run --rm --no-deps offsite python -m tulporgo_core.offsite keygen
TULPORGO_BACKUP_ENCRYPTION_KEY=
TULPORGO_R2_ENDPOINT=
TULPORGO_R2_BUCKET=
TULPORGO_R2_ACCESS_KEY_ID=
TULPORGO_R2_SECRET_ACCESS_KEY=

# --- Telegram ---
TULPORGO_BOT_TOKEN=
TULPORGO_BOT_USERNAME=tulporgobot
TULPORGO_OWNER_CHAT_ID=
TULPORGO_ADMIN_IDS=[]
TULPORGO_CHANNEL_USERNAME=tulporgo
TULPORGO_MINIAPP_URL=https://tulporgo.uz/app
TULPORGO_STORAGE_CHAT_ID=
# closed drivers group: join requests screened by the bot, member tags (bot must be admin there)
TULPORGO_DRIVERS_GROUP_ID=

# --- Telegram features (GOAL.md §4): ON by default since decision 55 (2026-11-10); set false to turn one off ---
# one topic per trip — OFF (decision 59): BotFather's Threaded Mode adds a fee to Telegram Stars purchases
TULPORGO_TRIP_TOPICS=false
# group commands /taksi, /yordam answered only to the asking user (ephemeral)
TULPORGO_EPHEMERAL_GROUP=true
# trip-status HTML widget in private chats (Bot API 10.4)
TULPORGO_WIDGETS=true
# Login with Telegram on tulporgo.uz outside Telegram: BotFather mini app -> @tulporgobot -> Login Widget -> Client
# Secret. Empty = off. Redirect URI https://tulporgo.uz/api/auth/telegram/callback (exact); Trusted Origins empty.
TULPORGO_LOGIN_CLIENT_SECRET=
# decision 65: also ask to let @tulporgobot message the user (scope telegram:bot_access); false = name and photo only
TULPORGO_LOGIN_BOT_ACCESS=true
# decision 66: also ask for the Telegram-verified phone (scope phone); stored only when the user has none yet
TULPORGO_LOGIN_PHONE=true

# Operator on the public legal pages (decision 67): full name and postal address. Kept out of the public repo —
# copy the two lines from the owner's .secrets/operator.env. Empty = the page shows the [ega: …] placeholder.
TULPORGO_OPERATOR_NAME=
TULPORGO_OPERATOR_ADDRESS=
TULPORGO_WEB_SESSION_HOURS=72

# --- product rules (decisions 10, 44, 52) ---
# everyone is free up to and including this date (YYYY-MM-DD)
TULPORGO_FREE_PERIOD_UNTIL=
TULPORGO_TRIAL_DAYS=7
TULPORGO_REFERRAL_BONUS_DAYS=7

# --- userbot (decisions 8, 48) ---
# TulporGo's own app from my.telegram.org (API development tools) — used for drivers' logins
TULPORGO_TELEGRAM_API_ID=
TULPORGO_TELEGRAM_API_HASH=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TULPORGO_USERBOT_ENCRYPTION_KEY=
TULPORGO_USERBOT_MIN_INTERVAL_MINUTES=45
TULPORGO_USERBOT_JITTER_MINUTES=15

# --- driver documents (decision 57): encrypted copy on this server (Fernet, separate from the userbot key).
# Required in production; empty = no server copy (development only). Keep a copy offline.
TULPORGO_DOCUMENTS_ENCRYPTION_KEY=

# --- payments (decision 44): sandbox until a merchant contract exists ---
TULPORGO_STARS_RATE_UZS=165
TULPORGO_P2P_CARD_NUMBER=
TULPORGO_P2P_CARD_HOLDER=
TULPORGO_CLICK_SERVICE_ID=
TULPORGO_CLICK_MERCHANT_ID=
TULPORGO_CLICK_SECRET_KEY=
TULPORGO_PAYME_MERCHANT_ID=
TULPORGO_PAYME_KEY=
TULPORGO_PAYME_TEST_MODE=true
